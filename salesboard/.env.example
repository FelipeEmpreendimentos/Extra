# Stripe secret key used only by the server-side Netlify Function.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx

# Optional: recommended for production. Create recurring monthly Prices in Stripe
# and paste the Price IDs below. If omitted, the function uses the safe server-side
# fallback amounts: Essencial R$14,90, Pro R$24,90, Negócios R$39,90.
STRIPE_PRICE_ESSENCIAL=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_NEGOCIOS=price_xxxxxxxxxxxxxxxxxxxxx

# Netlify sets URL automatically in production. Useful for local/preview environments.
URL=http://localhost:8888
