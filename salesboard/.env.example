# SalesBoard Finance — server-side environment (Supabase Edge Functions)
# Never expose secret values in browser code or commit real values.

# ==============================
# Supabase
# ==============================
# SUPABASE_URL is provided automatically by Supabase Edge Functions.
# Use the project service-role/secret through the Supabase secrets manager.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_project_secret

# ==============================
# Stripe Billing
# ==============================
# Use sk_test while validating the integration. Before launch, replace it with
# a LIVE Stripe secret and create LIVE products/prices; test IDs do not work
# with a live key.
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

STRIPE_PRICE_ESSENTIAL_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ESSENTIAL_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRODUCT_ESSENTIAL=prod_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRODUCT_PRO=prod_xxxxxxxxxxxxxxxxxxxxx

# ==============================
# Public/legal configuration
# ==============================
SUPPORT_EMAIL=contato@seudominio.com
PRIVACY_EMAIL=privacidade@seudominio.com
LEGAL_ENTITY_NAME=SEU_NOME_OU_RAZAO_SOCIAL
LEGAL_ENTITY_ID=SEU_CPF_OU_CNPJ
APP_NAME=SalesBoard Finance
