# ==============================
# Supabase (Auth + PostgreSQL)
# ==============================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
# SECRET: Functions only. Never expose this value in browser code.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# ==============================
# Stripe Billing
# ==============================
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# Create four recurring Prices in Stripe and paste their IDs here.
STRIPE_PRICE_ESSENCIAL_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ESSENCIAL_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_MONTHLY=price_xxxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PRO_ANNUAL=price_xxxxxxxxxxxxxxxxxxxxx

# ==============================
# Public/legal configuration
# ==============================
SUPPORT_EMAIL=contato@seudominio.com
LEGAL_ENTITY_NAME=SEU_NOME_OU_RAZAO_SOCIAL
LEGAL_ENTITY_ID=SEU_CPF_OU_CNPJ
PRIVACY_EMAIL=privacidade@seudominio.com
APP_NAME=SalesBoard Finance

# Netlify sets URL automatically in production.
URL=http://localhost:8888
