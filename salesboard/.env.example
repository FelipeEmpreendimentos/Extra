# Stripe secret key (server-side only)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxx

# Valor real cobrado em centavos. Ex.: 4990 = R$ 49,90
SUBSCRIPTION_PRICE_CENTS=4990
SUBSCRIPTION_CURRENCY=brl
SUBSCRIPTION_PLAN_NAME=SalesBoard Pro

# false = recomendado em produção. true = permite que o valor configurado na interface seja enviado ao checkout.
# Só use true em ambiente interno/admin autenticado.
ALLOW_DYNAMIC_PRICE=false
